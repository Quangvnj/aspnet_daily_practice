@model Day3.Models.PaginatedViewModel<Day3.Models.ProductViewModel>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Product List";
}

<div class="container mt-4">
    <h1 class="mb-4">Products</h1>

    <!-- Search Bar -->
    <div class="row mb-3">
        <div class="col-md-8">
            <form method="get" class="input-group">
                <input type="text" name="searchString" class="form-control" placeholder="Search by name or description..." 
                       value="@Model.SearchString" />
                <button type="submit" class="btn btn-primary">Search</button>
                @if (!string.IsNullOrEmpty(Model.SearchString))
                {
                    <a asp-action="Index" class="btn btn-secondary">Clear</a>
                }
            </form>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Create" class="btn btn-success">Create New Product</a>
        </div>
    </div>

    <!-- Results Info -->
    @if (!string.IsNullOrEmpty(Model.SearchString))
    {
        <div class="alert alert-info">
            Found <strong>@Model.TotalCount</strong> product(s) matching your search.
        </div>
    }

    <!-- Products Table -->
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>
                        <a asp-action="Index" 
                           asp-route-searchString="@Model.SearchString"
                           asp-route-sortBy="name"
                           asp-route-sortDirection="@(Model.SortBy == "name" && Model.SortDirection == "asc" ? "desc" : "asc")"
                           asp-route-pageNumber="1">
                            Name @if (Model.SortBy == "name")
                            {
                                <i class="@(Model.SortDirection == "asc" ? "bi bi-arrow-up" : "bi bi-arrow-down")"></i>
                            }
                        </a>
                    </th>
                    <th>
                        <a asp-action="Index"
                           asp-route-searchString="@Model.SearchString"
                           asp-route-sortBy="price"
                           asp-route-sortDirection="@(Model.SortBy == "price" && Model.SortDirection == "asc" ? "desc" : "asc")"
                           asp-route-pageNumber="1">
                            Price @if (Model.SortBy == "price")
                            {
                                <i class="@(Model.SortDirection == "asc" ? "bi bi-arrow-up" : "bi bi-arrow-down")"></i>
                            }
                        </a>
                    </th>
                    <th>Description</th>
                    <th>
                        <a asp-action="Index"
                           asp-route-searchString="@Model.SearchString"
                           asp-route-sortBy="category"
                           asp-route-sortDirection="@(Model.SortBy == "category" && Model.SortDirection == "asc" ? "desc" : "asc")"
                           asp-route-pageNumber="1">
                            Category @if (Model.SortBy == "category")
                            {
                                <i class="@(Model.SortDirection == "asc" ? "bi bi-arrow-up" : "bi bi-arrow-down")"></i>
                            }
                        </a>
                    </th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">No products found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>$@item.Price.ToString("F2")</td>
                            <td>@(item.Description?.Length > 50 ? item.Description.Substring(0, 50) + "..." : item.Description)</td>
                            <td>@item.CategoryName</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center">
                @if (Model.HasPreviousPage)
                {
                    <li class="page-item">
                        <a asp-action="Index"
                           asp-route-searchString="@Model.SearchString"
                           asp-route-sortBy="@Model.SortBy"
                           asp-route-sortDirection="@Model.SortDirection"
                           asp-route-pageNumber="@(Model.PageNumber - 1)"
                           class="page-link">Previous</a>
                    </li>
                }

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    @if (i == Model.PageNumber)
                    {
                        <li class="page-item active">
                            <span class="page-link">@i</span>
                        </li>
                    }
                    else if (i >= Model.PageNumber - 2 && i <= Model.PageNumber + 2)
                    {
                        <li class="page-item">
                            <a asp-action="Index"
                               asp-route-searchString="@Model.SearchString"
                               asp-route-sortBy="@Model.SortBy"
                               asp-route-sortDirection="@Model.SortDirection"
                               asp-route-pageNumber="@i"
                               class="page-link">@i</a>
                        </li>
                    }
                    else if (i == Model.PageNumber - 3 || i == Model.PageNumber + 3)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }
                }

                @if (Model.HasNextPage)
                {
                    <li class="page-item">
                        <a asp-action="Index"
                           asp-route-searchString="@Model.SearchString"
                           asp-route-sortBy="@Model.SortBy"
                           asp-route-sortDirection="@Model.SortDirection"
                           asp-route-pageNumber="@(Model.PageNumber + 1)"
                           class="page-link">Next</a>
                    </li>
                }
            </ul>
        </nav>

        <div class="text-center text-muted">
            Page @Model.PageNumber of @Model.TotalPages
        </div>
    }
</div>
